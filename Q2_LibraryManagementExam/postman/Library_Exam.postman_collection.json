{
  "info": {
    "name": "Q2 Library Management Exam",
    "_postman_id": "a3c555ec-ffff-4f9f-a111-888888888888",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 POST add book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert Martin\",\n  \"category\": \"Programming\",\n  \"availableCopies\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  if (body.id !== undefined) pm.collectionVariables.set(\"bookId\", String(body.id));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 GET all books",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books"
      }
    },
    {
      "name": "03 GET book by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    },
    {
      "name": "04 PUT update book",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books/{{bookId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code Updated\",\n  \"author\": \"Robert Martin\",\n  \"category\": \"Software Engineering\",\n  \"availableCopies\": 8\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05 DELETE book",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    },
    {
      "name": "06 GET deleted book (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "bookId",
      "value": "1"
    }
  ]
